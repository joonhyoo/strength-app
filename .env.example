PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only admin credential — REQUIRED in every environment. Coach invites,
# athlete-signup lookups (src/lib/server/supabaseAdmin.ts) and the dev quick-login
# button all go through it. Never exposed to the browser.
#   Local dev: the key printed by `supabase status`.
#   Production (Vercel): the hosted project's Secret key (sb_secret_…) from
#     Supabase Dashboard → Project Settings → API Keys.
# adminClient() reads SUPABASE_SECRET_KEY first, then SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
